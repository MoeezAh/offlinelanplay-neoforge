{
  "schema_version": 1,
  "quilt_loader": {
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
      "${mod_authors}"
    ],
    "contact": {
      "homepage": "https://github.com/MoeezAh/offlinelanplay-neoforge"
    },
    "license": "${mod_license}",
    "icon": "assets/${mod_id}/icon.png",
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "com.github.moeezah.OfflineLanPlay"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.24.0"
      },
      {
        "id": "minecraft",
        "versions": "~1.20.2"
      },
      {
        "id": "java",
        "versions": ">=17"
      }
    ]
  },
  "mixin": [
    "${mod_id}.mixins.json"
  ]
}
